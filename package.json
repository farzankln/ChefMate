{
  "name": "chef-mate",
  "version": "1.0.0",
  "private": true,
  "description": "Your personal cooking companion for organizing recipes and meal planning",
  "keywords": [
    "cooking",
    "recipes",
    "meal-planning",
    "nextjs",
    "typescript"
  ],
  "author": "Chef Mate Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
